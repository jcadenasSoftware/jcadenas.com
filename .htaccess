RewriteEngine On

# Force the canonical HTTPS domain to avoid duplicate URLs
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.jcadenas\.com$ [NC]
RewriteRule ^ https://jcadenas.com%{REQUEST_URI} [R=301,L]

RewriteRule ^xpendz/?$ xpendz.php [L]
RewriteRule ^xpendz/funciones/?$ xpendz-funciones.php [L]
RewriteRule ^xpendz/privacidad-y-seguridad/?$ xpendz-privacidad-seguridad.php [L]
RewriteRule ^xpendz/privacidad/?$ privacidad.php [L]
RewriteRule ^xpendz/eliminar-cuenta/?$ eliminar-cuenta.php [L]
RewriteRule ^xpendz/descargar/?$ xpendz-descargar.php [L]
RewriteRule ^funciones/?$ xpendz/funciones [R=301,L]
RewriteRule ^funciones\.php$ xpendz/funciones [R=301,L]
RewriteRule ^xpendz-funciones\.php$ xpendz/funciones [R=301,L]
RewriteRule ^xpendz-descargar\.php$ xpendz/descargar [R=301,L]
RewriteRule ^privacidad-y-seguridad/?$ xpendz/privacidad-y-seguridad [R=301,L]
RewriteRule ^privacidad-y-seguridad\.php$ xpendz/privacidad-y-seguridad [R=301,L]
RewriteRule ^xpendz-privacidad-seguridad\.php$ xpendz/privacidad-y-seguridad [R=301,L]
RewriteRule ^xpendz/privacidad-y-seguridad\.php$ xpendz/privacidad-y-seguridad [R=301,L]
RewriteRule ^privacidad/?$ xpendz/privacidad [R=301,L]
RewriteRule ^privacidad\.php$ xpendz/privacidad [R=301,L]
RewriteRule ^xpendz/privacidad\.php$ xpendz/privacidad [R=301,L]
RewriteRule ^eliminar-cuenta/?$ xpendz/eliminar-cuenta [R=301,L]
RewriteRule ^eliminar-cuenta\.php$ xpendz/eliminar-cuenta [R=301,L]
RewriteRule ^xpendz/eliminar-cuenta\.php$ xpendz/eliminar-cuenta [R=301,L]
RewriteRule ^descargar/?$ xpendz/descargar [R=301,L]
RewriteRule ^descargar\.php$ xpendz/descargar [R=301,L]
RewriteRule ^xpendz/descargar\.php$ xpendz/descargar [R=301,L]

RewriteRule ^sitemap\.xml$ sitemap.php [L]
